{
  "name": "@qeetrix/icons",
  "version": "1.0.1",
  "private": false,
  "description": "Qeetrix Icons — the Qeet Group icon library. Outline icons on a 24×24 grid, generated from canonical SVG.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qeetgroup/qeetrix-icons.git"
  },
  "bugs": {
    "url": "https://github.com/qeetgroup/qeetrix-icons/issues"
  },
  "homepage": "https://github.com/qeetgroup/qeetrix-icons#readme",
  "keywords": [
    "icons",
    "svg",
    "react",
    "qeet",
    "qeetrix",
    "design-system"
  ],
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=20",
    "bun": ">=1.3.14"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./icons/*": {
      "types": "./dist/icons/*.d.ts",
      "import": "./dist/icons/*.js",
      "default": "./dist/icons/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "generate:check": "node scripts/generate.mjs --check",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "rm -rf dist && node scripts/generate.mjs && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "prepack": "bun run build"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.19.19",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^29.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsc-alias": "^1.8.17",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "publishConfig": {
    "access": "public"
  }
}
