{
  "name": "@qeetrix/icons",
  "version": "1.0.10",
  "private": false,
  "description": "Qeetrix Icons — Lucide icons in round and sharp shapes with derived filled variants, plus theSVG brand logos, as tree-shakeable React components.",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qeetgroup/qeetrix-icons.git"
  },
  "bugs": {
    "url": "https://github.com/qeetgroup/qeetrix-icons/issues"
  },
  "homepage": "https://github.com/qeetgroup/qeetrix-icons#readme",
  "keywords": [
    "icons",
    "svg",
    "qeet",
    "qeetrix",
    "design-system",
    "lucide",
    "logos",
    "brand-logos",
    "thesvg"
  ],
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=20",
    "bun": ">=1.3.14"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./icons/*": {
      "types": "./dist/generated/icons/*.d.ts",
      "import": "./dist/generated/icons/*.js",
      "default": "./dist/generated/icons/*.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js",
      "default": "./dist/manifest.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p playground/tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:icons": "bun scripts/check/check-icons.ts",
    "generate": "bun scripts/build/generate-icons.ts",
    "derive:filled": "bun scripts/build/derive-filled.ts",
    "check:filled": "bun scripts/build/derive-filled.ts --check",
    "derive:sharp": "bun scripts/build/derive-sharp.ts",
    "check:sharp": "bun scripts/build/derive-sharp.ts --check",
    "stamp:override": "bun scripts/build/stamp-override.ts",
    "sync:lucide": "bun scripts/sync/sync-lucide.ts",
    "check:brands": "bun scripts/check/check-brands.ts",
    "generate:logos": "bun scripts/build/generate-logos.ts",
    "check:logos": "bun scripts/build/generate-logos.ts --check",
    "check:generated": "bun scripts/check/check-generated.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "playground": "vite --config playground/vite.config.ts",
    "playground:build": "vite build --config playground/vite.config.ts",
    "prepack": "bun run build"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/node": "^22.19.19",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@xmldom/xmldom": "0.9.12",
    "canvaskit-wasm": "0.42.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.9"
  },
  "publishConfig": {
    "access": "public"
  }
}
