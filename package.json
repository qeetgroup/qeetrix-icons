{
  "name": "@qeetrix/icons",
  "version": "0.1.1",
  "private": false,
  "description": "Qeetrix Icons — the Qeet Group icon library. Outline icons on a 24×24 grid, generated from canonical SVG.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qeetgroup/qeetrix-icons.git"
  },
  "bugs": {
    "url": "https://github.com/qeetgroup/qeetrix-icons/issues"
  },
  "homepage": "https://github.com/qeetgroup/qeetrix-icons#readme",
  "keywords": [
    "icons",
    "svg",
    "react",
    "qeet",
    "qeetrix",
    "design-system"
  ],
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=20",
    "bun": ">=1.3.14"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./metadata": {
      "types": "./dist/metadata.d.ts",
      "import": "./dist/metadata.js",
      "default": "./dist/metadata.js"
    },
    "./icons/*": {
      "types": "./dist/icons/*.d.ts",
      "import": "./dist/icons/*.js",
      "default": "./dist/icons/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "validate": "node scripts/validate.mjs",
    "generate": "node scripts/generate.mjs",
    "generate:check": "node scripts/generate.mjs --check",
    "explorer": "node scripts/explorer.mjs",
    "doctor": "node scripts/doctor.mjs",
    "catalog": "node scripts/catalog.mjs",
    "catalog:check": "node scripts/catalog.mjs --check",
    "api": "node scripts/api-docs.mjs",
    "api:check": "node scripts/api-docs.mjs --check",
    "verify:package": "node scripts/verify-package.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "bun run clean && node scripts/generate.mjs && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "bun run build && changeset publish",
    "prepack": "bun run build"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@changesets/cli": "^2.31.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.19.19",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "axe-core": "^4.12.1",
    "jsdom": "^29.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "svgson": "^5.3.1",
    "tsc-alias": "^1.8.17",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9",
    "vitest-axe": "^0.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
