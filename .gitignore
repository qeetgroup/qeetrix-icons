# Dependencies
node_modules

# Build output — dist/ is the only build directory
dist
*.tsbuildinfo

# Packed tarballs (produced by `bun pm pack` during verification)
*.tgz

# NOTE: src/icons/** and src/metadata.ts are GENERATED by scripts/generate.mjs
# but are deliberately committed — they are tracked artifacts, guarded by
# `bun run generate:check`. Do not add them here.

# Logs
*.log
npm-debug.log*

# Editor / OS
.DS_Store
.idea
.vscode/*
!.vscode/extensions.json
*.local

# Claude agent run logs
.claude/logs/

# Local icon explorer and review sheets (bun run explorer) — derived data
.explorer
