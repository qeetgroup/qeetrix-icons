{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "tsBuildInfoFile": "./node_modules/.cache/qeetrix-icons/tsconfig.build.tsbuildinfo"
  },
  "include": ["src"],
  "exclude": ["dist"],
  "tsc-alias": {
    "resolveFullPaths": true,
    "verbose": false
  }
}
